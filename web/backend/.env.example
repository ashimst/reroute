# ── Groq (required for LLM fallback) ─────────────────────────────────────────
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=qwen/qwen3.8-27b

# ── OpenJEV (optional – uses keyword routing if not set) ─────────────────────
# OPENJEV_API_KEY=your_openjev_key
# OPENJEV_BASE_URL=https://api.codiv.ai

# ── Thresholds ────────────────────────────────────────────────────────────────
ROUTING_CONFIDENCE_THRESHOLD=0.6
RESOLUTION_CONFIDENCE_THRESHOLD=0.5

# ── Paths (relative to reroute/) ─────────────────────────────────────────────
OLIST_DATA_DIR=data/olist
POLICY_DIR=data/policies
VECTOR_STORE_PATH=data/policy_index
