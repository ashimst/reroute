# ─────────────────────────────────────────────
# Retail Flow – REROUTE Environment Variables
# Copy this file to .env and fill in real values
# ─────────────────────────────────────────────

# Groq API key (required for LLM fallback)
GROQ_API_KEY=your_groq_api_key_here

# Groq model to use for fallback reasoning
GROQ_MODEL=qwen/qwen3.8-27b

# OpenJEV backend: "mock" (no download) or "hf" (HuggingFace model)
# Use "mock" for local development without GPU
OPENJEV_BACKEND=mock

# HuggingFace model for OpenJEV when backend=hf (optional)
OPENJEV_HF_MODEL=Qwen/Qwen2.5-0.5B-Instruct

# Confidence threshold below which the system falls back to Groq
ROUTING_CONFIDENCE_THRESHOLD=0.6

# Confidence threshold below which the system escalates to human
RESOLUTION_CONFIDENCE_THRESHOLD=0.5

# Path to olist data directory (relative to reroute/ project root)
OLIST_DATA_DIR=data/olist

# Path to policy documents directory (relative to reroute/ project root)
POLICY_DIR=data/policies

# Path to FAISS vector store cache (will be created on first run)
VECTOR_STORE_PATH=data/policy_index
